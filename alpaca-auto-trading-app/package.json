{
  "name": "alpaca-auto-trading-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "jest --selectProjects unit --runInBand",
    "test:int": "jest --selectProjects integration --runInBand",
    "test:cov": "jest --coverage --selectProjects unit,integration",
    "test:agent": "vitest run agent/",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "e2e": "start-server-and-test dev http://localhost:3000 'cypress run --browser chrome --headless'",
    "lhci": "lhci autorun",
    "ci:all": "pnpm test:cov && pnpm e2e && pnpm lhci",
    "metrics": "node ./src/server/metrics.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test:performance": "jest --testPathPattern=performance",
    "performance": "./scripts/performance-check.sh",
    "deploy": "./scripts/deploy.sh",
    "deploy:vercel": "vercel --prod",
    "analyze:bundle": "npm run build && npx source-map-explorer 'build/static/js/*.js' --html > bundle-analysis.html",
    "optimize": "npm run prune && npm run build && npm run analyze:bundle",
    "prune": "npm prune && npm audit fix",
    "doc:generate": "ts-node generate-knowledge.ts",
    "doc:prompts": "ts-node scripts/generate-prompts.ts",
    "doc:embed": "ts-node scripts/embed-knowledge.ts",
    "doc:watch": "chokidar \"src/**/*.ts?(x)\" -c \"npm run doc:quick\"",
    "verify": "tsc --noEmit && npm run doc:generate && npm run doc:prompts",
    "prepare": "husky install",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "doc:quick": "ts-node generate-knowledge.ts && ts-node scripts/generate-prompts.ts"
  },
  "dependencies": {
