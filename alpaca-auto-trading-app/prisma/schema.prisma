generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Trade {
  id           String   @id @default(cuid())
  symbol       String
  side         String   // buy/sell
  qty          Float
  price        Float
  filledAt     DateTime
  strategyTag  String?  // optionnel
  pnl          Float?   // PnL de la trade (si calculé)
  createdAt    DateTime @default(now())
  
  @@index([symbol])
  @@index([filledAt])
}

model Position {
  id        String   @id @default(cuid())
  symbol    String   @unique
  qty       Float
  avgPrice  Float
  updated   DateTime @updatedAt
  
  @@index([symbol])
}

model PnLDay {
  id        String   @id @default(cuid())
  date      DateTime @unique
  realized  Float    // PnL réalisé
  unrealized Float?  // optionnel
  createdAt DateTime @default(now())
  
  @@index([date])
}

model AlertRule {
  id          String   @id @default(cuid())
  symbol      String
  type        String   // "sentiment", "volatility", "donchian", "adx"
  paramsJson  String   // JSON params (ex: {"lookback":20,"threshold":0.7})
  active      Boolean  @default(true)
  lastFiredAt DateTime?
  createdAt   DateTime @default(now())
  
  @@index([symbol])
  @@index([active])
}

model WatchItem {
  id        String   @id @default(cuid())
  symbol    String   @unique
  note      String?
  createdAt DateTime @default(now())
  
  @@index([symbol])
}

model FactorSnapshot {
  id        String   @id @default(cuid())
  symbol    String
  asOf      DateTime @default(now())
  momentum  Float
  value     Float
  quality   Float
  risk      Float
  growth    Float
  
  @@index([symbol, asOf])
}

model NewsCache {
  id        String   @id @default(cuid())
  symbol    String?
  source    String   // polygon|finnhub|newsapi
  title     String
  url       String
  published DateTime
  sentiment Float?   // -1..+1
  rawJson   String
  createdAt DateTime @default(now())
  
  @@index([symbol])
  @@index([published])
}

model EconEvent {
  id         String   @id @default(cuid())
  country    String?
  title      String
  date       DateTime
  impact     String?
  rawJson    String
  createdAt  DateTime @default(now())
  
  @@index([date])
}

model ai_suggestions_daily {
  id           String   @id @default(cuid())
  day          DateTime // date "jour" (00:00 UTC)
  symbol       String
  score        Float
  rsi          Float?
  momentum     Float?
  breakout     Boolean?
  weightsJson  Json     // { wDonchian, wMomentum, wRSI, buyThreshold, universeSize, ... }
  paramsHash   String   // hash des poids + seuils + backtest params
  createdAt    DateTime @default(now())

  @@index([day, score])
  @@index([day, symbol])
}

model user_profile {
  id           String  @id @default(cuid())
  email        String  @unique
  displayName  String?
  riskLevel    Int     @default(2) // 1=conservateur, 2=équilibré, 3=dynamique
  horizonYears Int     @default(5)
  incomeYear   Float?  // revenu annuel
  savingsRate  Float?  // % épargne
  goalsJson    Json?   // [{type:"retirement", amount:...}, ...]
  holdingsJson Json?   // [{symbol:"SPY", pct:0.4}, ...]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model advisor_feedback {
  id          String   @id @default(cuid())
  ts          DateTime @default(now())
  symbol      String
  action      String   // "buy" | "add" | "trim" | "hold" | "sell"
  score       Float
  decision    String   // "accepted" | "rejected"
  contextJson Json     // snapshot params/weights
  userEmail   String
  @@index([userEmail, ts])
}

model ai_conversation {
  id         String   @id @default(cuid())
  userEmail  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  title      String?
  messages   ai_message[]
  @@index([userEmail, createdAt])
}

model ai_message {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // 'user' | 'assistant' | 'system'
  content        String
  createdAt      DateTime @default(now())
  ai_conversation ai_conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  embeddingId    String?
}

model ai_embedding {
  id           String   @id @default(cuid())
  userEmail    String
  messageId    String?
  docType      String   // 'message' | 'report' | 'note'
  vector       Bytes
  dim          Int
  metadataJson Json
  createdAt    DateTime @default(now())
  @@index([userEmail, docType])
}

model ai_report {
  id         String   @id @default(cuid())
  userEmail  String
  day        DateTime
  summary    String
  details    String
  json       Json
  createdAt  DateTime @default(now())
  @@index([userEmail, day])
}

model ai_bandit_weight {
  id          String   @id @default(cuid())
  userEmail   String
  // bras/arms: donchian, momentum, rsi (peuvent s'élargir)
  wDonchian   Float    @default(0.45)
  wMomentum   Float    @default(0.35)
  wRSI        Float    @default(0.20)
  epsilon     Float    @default(0.1)   // exploration
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  @@unique([userEmail])
}

model ai_authorization {
  id        String   @id @default(cuid())
  userEmail String
  scope     String   // 'orders.place' | 'rebalance.auto' | 'payments.adjust' ...
  level     Int      @default(0) // 0=off, 1=ask, 2=auto-with-log
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@index([userEmail, scope])
}

model integration_snapshot {
  id        String   @id @default(cuid())
  userEmail String
  day       DateTime
  macroJson Json
  newsJson  Json
  weatherJson Json
  createdAt DateTime @default(now())
  @@index([userEmail, day])
}