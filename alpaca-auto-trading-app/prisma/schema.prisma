generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Trade {
  id           String   @id @default(cuid())
  symbol       String
  side         String   // buy/sell
  qty          Float
  price        Float
  filledAt     DateTime
  strategyTag  String?  // optionnel
  pnl          Float?   // PnL de la trade (si calculé)
  createdAt    DateTime @default(now())
  
  @@index([symbol])
  @@index([filledAt])
}

model Position {
  id        String   @id @default(cuid())
  symbol    String   @unique
  qty       Float
  avgPrice  Float
  updated   DateTime @updatedAt
  
  @@index([symbol])
}

model PnLDay {
  id        String   @id @default(cuid())
  date      DateTime @unique
  realized  Float    // PnL réalisé
  unrealized Float?  // optionnel
  createdAt DateTime @default(now())
  
  @@index([date])
}

model AlertRule {
  id          String   @id @default(cuid())
  symbol      String
  type        String   // "sentiment", "volatility", "donchian", "adx"
  paramsJson  String   // JSON params (ex: {"lookback":20,"threshold":0.7})
  active      Boolean  @default(true)
  lastFiredAt DateTime?
  createdAt   DateTime @default(now())
  
  @@index([symbol])
  @@index([active])
}

model WatchItem {
  id        String   @id @default(cuid())
  symbol    String   @unique
  note      String?
  createdAt DateTime @default(now())
  
  @@index([symbol])
}

model FactorSnapshot {
  id        String   @id @default(cuid())
  symbol    String
  asOf      DateTime @default(now())
  momentum  Float
  value     Float
  quality   Float
  risk      Float
  growth    Float
  
  @@index([symbol, asOf])
}

model NewsCache {
  id        String   @id @default(cuid())
  symbol    String?
  source    String   // polygon|finnhub|newsapi
  title     String
  url       String
  published DateTime
  sentiment Float?   // -1..+1
  rawJson   String
  createdAt DateTime @default(now())
  
  @@index([symbol])
  @@index([published])
}

model EconEvent {
  id         String   @id @default(cuid())
  country    String?
  title      String
  date       DateTime
  impact     String?
  rawJson    String
  createdAt  DateTime @default(now())
  
  @@index([date])
}