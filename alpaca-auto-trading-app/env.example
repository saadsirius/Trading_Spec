# Database
DATABASE_URL="postgresql://username:password@localhost:5432/alpaca_trading"

# Alpaca API Keys - Paper Trading
ALPACA_PAPER_KEY="your_paper_key_here"
ALPACA_PAPER_SECRET="your_paper_secret_here"

# Alpaca API Keys - Live Trading
ALPACA_LIVE_KEY="your_live_key_here"
ALPACA_LIVE_SECRET="your_live_secret_here"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Email (for notifications)
EMAIL_FROM="noreply@yourdomain.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"

# Push Notifications
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_EMAIL="mailto:your_email@domain.com"

# Safety Features
LIVE_GLOBAL_PAUSE="false"
MAX_LIVE_ORDERS_PER_DAY="10"
DAILY_LOSS_LIMIT_PERCENT="1.0"

# Sentry (optional)
SENTRY_DSN="your_sentry_dsn_here"
