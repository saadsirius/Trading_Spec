# 🔑 Clés API Alpaca (Paper Trading)
APCA_API_KEY_ID=your_alpaca_key_id_here
APCA_API_SECRET_KEY=your_alpaca_secret_key_here
APCA_PAPER_BASE_URL=https://paper-api.alpaca.markets/v2
APCA_DATA_BASE_URL=https://data.alpaca.markets/v2

# 🔑 Clés API externes (optionnelles)
POLYGON_API_KEY=poly_your_polygon_key_here
FINNHUB_API_KEY=fin_your_finnhub_key_here
NEWSAPI_KEY=news_your_newsapi_key_here
TRAD_ECON_API_KEY=te_your_trading_economics_key_here

# 🔐 Clé secrète pour l'application
SECRET_KEY=your_secret_key_here

# 🗄️ Base de données
DATABASE_URL="file:./dev.db"

# 📊 Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 📈 Métriques
METRICS_PORT=9300

# 📧 Notifications (optionnel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=