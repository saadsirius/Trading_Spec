# Alpaca Trading API Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# API Configuration
# =============================================================================
APP_NAME="Alpaca Trading API"
DEBUG=false
VERSION="1.0.0"
HOST="0.0.0.0"
PORT=8000

# =============================================================================
# Alpaca API Configuration
# =============================================================================
# Get these from: https://app.alpaca.markets/paper/dashboard/overview
APCA_API_KEY_ID=changeme
APCA_API_SECRET_KEY=changeme

# Paper trading URL (default)
APCA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Live trading URL (only use with live keys)
APCA_LIVE_BASE_URL=https://api.alpaca.markets

# =============================================================================
# OpenAI Configuration
# =============================================================================
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=changeme

# =============================================================================
# Database Configuration
# =============================================================================
# For development, SQLite is fine
DATABASE_URL=sqlite+aiosqlite:///./app.db

# For production, use PostgreSQL
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/alpaca_trading

# =============================================================================
# Security Configuration
# =============================================================================
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changeme

# JWT token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# CORS Configuration
# =============================================================================
# Add your frontend URLs here
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# =============================================================================
# Trading Configuration
# =============================================================================
# Set to true for live trading (requires live Alpaca keys)
IS_LIVE=false

# Default trading settings
DEFAULT_ORDER_SIZE=100
MAX_POSITION_SIZE=10000
RISK_PER_TRADE=0.02
